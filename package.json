{
  "name": "waf-controller",
  "version": "0.1.0",
  "private": true,
  "description": "Контроллер WAF: HTTP API для отладочного UX",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node src/migrate.ts",
    "migrate:check": "node src/migrate.ts --check",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "load-geo": "node src/load-geo.ts",
    "dump-geo": "node src/dump-geo.ts",
    "ux:build": "npm run build --prefix ux",
    "ux": "npm run dev --prefix ux"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nats": "^2.29.3",
    "pg": "^8.16.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
