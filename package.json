{
  "name": "placitum-controller",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Placitum controller: configuration API and admin panel",
  "license": "Apache-2.0",
  "homepage": "https://github.com/exemt/placitum-controller#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exemt/placitum-controller.git"
  },
  "bugs": {
    "url": "https://github.com/exemt/placitum-controller/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node src/migrate.ts",
    "migrate:check": "node src/migrate.ts --check",
    "load-geo": "node src/load-geo.ts",
    "ux:build": "npm run build --prefix ux",
    "ux": "npm run dev --prefix ux"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nats": "^2.29.3",
    "pg": "^8.16.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
